{
  "info": {
    "name": "TalkAM API v2",
    "description": "TalkAM v2 API collection. v2 is a parallel lane mounted at api/v2 — v1 stays untouched. Grown section by section as endpoint shapes freeze.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "01 Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "full_name", "value": "Ada Chioma Obi", "type": "text" },
                { "key": "email", "value": "ada.obi@example.com", "type": "text" },
                { "key": "phone_number", "value": "+2348012345678", "type": "text" },
                { "key": "username", "value": "ada_obi", "type": "text" },
                { "key": "country_id", "value": "1", "type": "text", "description": "Optional. Must exist in countries table." },
                { "key": "gender", "value": "Female", "type": "text", "description": "Optional" },
                { "key": "date_of_birth", "value": "1995-04-12", "type": "text", "description": "Optional, Y-m-d" },
                { "key": "password", "value": "StrongP@ss1", "type": "text", "description": "8-32 chars, upper+lower+digit+special" }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/v2/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "auth", "register"]
            },
            "description": "Registers a user. full_name is split into first/middle/last server-side. Sends a 6-digit email verification OTP. Returns {token, user}."
          }
        },
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "input", "value": "ada.obi@example.com", "type": "text", "description": "Email or username" },
                { "key": "password", "value": "StrongP@ss1", "type": "text" },
                { "key": "fcm_token", "value": "", "type": "text", "description": "Optional" }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/v2/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "auth", "login"]
            },
            "description": "Reused v1 behavior. Returns {token, user}. Re-sends a verify PIN if email is unverified."
          }
        },
        {
          "name": "OAuth Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "token", "value": "<provider-token>", "type": "text" },
                { "key": "provider", "value": "google", "type": "text", "description": "google | apple | facebook | tiktok" },
                { "key": "fcm_token", "value": "", "type": "text", "description": "Optional" }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/v2/auth/oauth-login",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "auth", "oauth-login"]
            },
            "description": "Reused v1 behavior. Auto-creates the user on first provider sign-in."
          }
        },
        {
          "name": "Username Available",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v2/auth/username/available?username=ada_obi",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "auth", "username", "available"],
              "query": [{ "key": "username", "value": "ada_obi" }]
            },
            "description": "Public, throttled (30/min). data: {username, available}. Serves the Create Account and anonymous-mode screens."
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "email", "value": "ada.obi@example.com", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/v2/auth/password/forgot",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "auth", "password", "forgot"]
            },
            "description": "Sends a 6-digit reset code to the email. Throttled (5/min)."
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "code", "value": "123456", "type": "text" },
                { "key": "password", "value": "NewStr0ng@Pass", "type": "text" },
                { "key": "password_confirmation", "value": "NewStr0ng@Pass", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/v2/auth/password/reset",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "auth", "password", "reset"]
            },
            "description": "Requires confirmation + strength regex; the new password must differ from the current one. The code is single-use."
          }
        },
        {
          "name": "OTP Request",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "email", "value": "ada.obi@example.com", "type": "text" },
                { "key": "type", "value": "verify_email", "type": "text", "description": "verify_email | password_reset" }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/v2/auth/otp/request",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "auth", "otp", "request"]
            },
            "description": "Issues a 6-digit email code. Throttled (5/min); the 60s client resend countdown is covered server-side."
          }
        },
        {
          "name": "OTP Verify",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "code", "value": "123456", "type": "text" },
                { "key": "email", "value": "ada.obi@example.com", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/v2/auth/otp/verify",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "auth", "otp", "verify"]
            },
            "description": "Verifies the 6-digit code and sets email_verified_at."
          }
        }
      ]
    },
    {
      "name": "02 Onboarding",
      "item": [
        {
          "name": "Me (with onboarding state)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v2/user/me",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "user", "me"]
            },
            "description": "v1 me payload plus a computed data.onboarding object: {user_type, interests, avatar, consents, completed_at}. The app resumes onboarding at the first false step."
          }
        },
        {
          "name": "Interest Topics",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v2/user/interest-topics",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "user", "interest-topics"]
            },
            "description": "The onboarding interest chips (post_categories rows marked type=interest_topic). No parameters."
          }
        },
        {
          "name": "Sync Interests (min 3)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"interests\": [12, 13, 14]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v2/user/profile/interests",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "user", "profile", "interests"]
            },
            "description": "Batch interest selection from onboarding. Minimum 3 IDs; deduped server-side."
          }
        },
        {
          "name": "Avatars (preset grid)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v2/profile/avatars",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "profile", "avatars"]
            },
            "description": "Reused v1 preset avatar list. Public."
          }
        },
        {
          "name": "Profile Update (set avatar)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "avatar", "value": "3", "type": "text", "description": "Preset avatar id. Skippable — just don't call." }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/v2/user/profile/update",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "user", "profile", "update"]
            },
            "description": "Reused v1 profile update (also accepts name, username, gender, date_of_birth, ...)."
          }
        },
        {
          "name": "Set User Type",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "user_type", "value": "support_seeker", "type": "text", "description": "support_seeker | mental_health_pro" }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/v2/user/onboarding/user-type",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "user", "onboarding", "user-type"]
            },
            "description": "Records onboarding intent only — role stays User."
          }
        },
        {
          "name": "Get Consents",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v2/user/consents",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "user", "consents"]
            },
            "description": "State of all four consent keys: account_operation, session_delivery (required), anonymous_community, anonymised_research (optional)."
          }
        },
        {
          "name": "Update Consents",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"consents\": {\n    \"account_operation\": true,\n    \"session_delivery\": true,\n    \"anonymous_community\": true,\n    \"anonymised_research\": false\n  },\n  \"policy_version\": \"2026-07\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v2/user/consents",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "user", "consents"]
            },
            "description": "First confirm requires both required keys true. Required keys can never be toggled off (400 — that path is account deletion). Optional keys toggle freely; revocation is go-forward (revoked_at set, granted_at preserved)."
          }
        },
        {
          "name": "Complete Onboarding",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v2/user/onboarding/complete",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "user", "onboarding", "complete"]
            },
            "description": "Stamps users.onboarding_completed_at and returns the derived onboarding object."
          }
        },
        {
          "name": "Privacy Policies",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v2/user/privacy-policies",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "user", "privacy-policies"]
            },
            "description": "Reused v1 privacy policy content. Public."
          }
        }
      ]
    },
    {
      "name": "03 Home Feed",
      "item": [
        {
          "name": "Feed (For You)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v2/user/posts?tab=for_you&category_id=",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "user", "posts"],
              "query": [
                { "key": "tab", "value": "for_you", "description": "for_you | trending" },
                { "key": "category_id", "value": "", "description": "Optional topic chip filter (id from interest-topics)" }
              ]
            },
            "description": "Interest-category posts first (recency-ordered), backfilled with popular recent posts. Paginated; impressions logged."
          }
        },
        {
          "name": "Feed (Trending)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v2/user/posts?tab=trending",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "user", "posts"],
              "query": [{ "key": "tab", "value": "trending" }]
            },
            "description": "Engagement-ranked (comments + likes) over the recent 2-month window."
          }
        },
        {
          "name": "Post Detail",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v2/user/posts/1",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "user", "posts", "1"]
            },
            "description": "Reused v1 post detail (Read More). Logs click + recent view."
          }
        },
        {
          "name": "React (Like)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "post_id", "value": "1", "type": "text" },
                { "key": "action", "value": "Like", "type": "text", "description": "Like | Dislike — toggles" }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/v2/user/posts/reaction",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "user", "posts", "reaction"]
            },
            "description": "Reused v1 reaction toggle."
          }
        },
        {
          "name": "Save Post Stats (share)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "post_id", "value": "1", "type": "text" },
                { "key": "shares", "value": "true", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/v2/user/posts/stats/save",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "user", "posts", "stats", "save"]
            },
            "description": "Reused v1 stats tracking (shares, engagements, clicks...)."
          }
        },
        {
          "name": "Fetch Post Stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v2/user/posts/stats/fetch?post_id=1",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "user", "posts", "stats", "fetch"],
              "query": [{ "key": "post_id", "value": "1" }]
            },
            "description": "Reused v1 stats fetch."
          }
        },
        {
          "name": "Mood Check-in (today)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v2/user/mood-checkins/today",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "user", "mood-checkins", "today"]
            },
            "description": "Gates the check-in modal: data = {checked_in, mood, checked_in_on}."
          }
        },
        {
          "name": "Mood Check-in (record)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "mood", "value": "4", "type": "text", "description": "1-5" }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/v2/user/mood-checkins",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "user", "mood-checkins"]
            },
            "description": "One check-in per calendar day; a same-day repeat updates the row."
          }
        },
        {
          "name": "Announcements (therapist banner)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v2/user/announcements",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "user", "announcements"]
            },
            "description": "Reused v1 announcements — serves the server-controlled therapist prompt banner."
          }
        }
      ]
    },
    {
      "name": "04 Posts",
      "item": [
        {
          "name": "Create Post",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category_id\": 12,\n  \"type\": \"Text\",\n  \"title\": \"Managing anxiety day to day\",\n  \"body\": \"Max 500 chars.\",\n  \"tags\": [\"anxiety\"],\n  \"is_anonymous\": 0,\n  \"status\": \"Active\",\n  \"publish_at\": null\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v2/user/posts",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "user", "posts"]
            },
            "description": "v2 rules: title required, tags min 1, body <= 500 chars, category_id must be an interest topic. status=Scheduled + publish_at schedules; followers are notified of non-anonymous published posts."
          }
        },
        {
          "name": "Create Reply",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "post_id", "value": "1", "type": "text" },
                { "key": "comment", "value": "Replying (max 500 chars). Mention with $@username$.", "type": "text" },
                { "key": "parent_id", "value": "", "type": "text", "description": "Optional thread parent comment id" },
                { "key": "reply_comment_id", "value": "", "type": "text", "description": "Optional replied-to comment id" },
                { "key": "is_anonymous", "value": "0", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/v2/user/post-comments",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "user", "post-comments"]
            },
            "description": "500-char server max; threading/mentions/anonymous reuse v1 logic."
          }
        },
        {
          "name": "List Comments",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v2/user/post-comments?post_id=1",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "user", "post-comments"],
              "query": [{ "key": "post_id", "value": "1" }]
            },
            "description": "v1 listing plus muted users excluded."
          }
        },
        {
          "name": "Comment Reaction",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "comment_id", "value": "1", "type": "text" },
                { "key": "action", "value": "Like", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/v2/user/post-comments/reaction",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "user", "post-comments", "reaction"]
            },
            "description": "Reused v1 toggle."
          }
        },
        {
          "name": "Report Post",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "post_id", "value": "1", "type": "text" },
                { "key": "reason", "value": "Spam", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/v2/user/posts/report",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "user", "posts", "report"]
            }
          }
        },
        {
          "name": "Report Comment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "comment_id", "value": "1", "type": "text" },
                { "key": "post_id", "value": "1", "type": "text" },
                { "key": "reason", "value": "Harassment", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/v2/user/posts/report-comment",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "user", "posts", "report-comment"]
            },
            "description": "Requires comment_id AND post_id (v1 contract)."
          }
        },
        {
          "name": "Not Interested (toggle)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "post_id", "value": "1", "type": "text" }]
            },
            "url": {
